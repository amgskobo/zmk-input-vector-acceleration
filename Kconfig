DT_COMPAT_ZMK_INPUT_PROCESSOR_VECTOR_ACCELERATION := zmk,input-processor-vector-acceleration

config ZMK_INPUT_PROCESSOR_VECTOR_ACCELERATION
    bool "Vector pointer acceleration input processor"
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_INPUT_PROCESSOR_VECTOR_ACCELERATION))
    depends on ZMK_POINTING
    depends on INPUT
    help
      Enables report-based, fixed-point acceleration for relative X/Y pointer
      events. One common gain is applied to both axes so acceleration does not
      change the direction of motion.
